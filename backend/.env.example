# Copy to backend/.env and adjust. Never commit a real .env.
ENVIRONMENT=development

# Defaults to backend/trustflow.db when unset. For Postgres use e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/trustflow
# DATABASE_URL=

# Must be at least 32 bytes in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-in-production-use-a-random-48-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI provider. Leave AI_API_KEY empty and every AI service reports
# "unavailable" instead of fabricating output. The deterministic engine is unaffected.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
